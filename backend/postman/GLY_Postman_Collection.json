            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    var res = pm.response.json();",
                  "    if (res.accessToken) {",
                  "        pm.collectionVariables.set('jwt_token', res.accessToken);",
                  "        console.log('✅ Đã tự động lưu JWT Token vào biến môi trường!');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
